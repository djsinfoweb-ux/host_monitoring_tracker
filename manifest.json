{
  "manifest_version": 2.0,
  "id": "host_monitoring_tracker",
  "name": "Acompanhamento de Host",
  "version": "1.2.0",
  "namespace": "HostMonitoringTracker",
  "description": "Módulo para acompanhar limites de hosts por empresa, com grupos pai/filho em visualização hierárquica recolhível",
  "author": "Danilo Santos",
  "actions": {
    "hosttracker.view": {
      "class": "HostTrackerView",
      "view": "module.hosttracker.view"
    },
    "hosttracker.edit": {
      "class": "HostTrackerEdit",
      "view": "module.hosttracker.edit"
    },
    "hosttracker.pdf": {
      "class": "HostTrackerPdf"
    }
  },
  "assets": {
    "css": [
      "hosttracker.css"
    ],
    "js": [
      "hosttracker.js"
    ]
  }
}
